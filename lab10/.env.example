# Copy to .env for local development. .env is ignored by Git - never commit real secrets.
APP_NAME="Experiment Registry"
ENVIRONMENT=development            # development | test | production (alias: APP_ENV)
DATABASE_URL=sqlite:///experiments.db
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
# API_TOKEN=<long random value>    # optional; protects POST/PATCH/DELETE (X-API-Token header)
